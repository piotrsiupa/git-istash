#!/usr/bin/env sh

set -eu

. "$(dirname "$0")/../lib/git-istash/git-istash-io"

min_git_version='2.43.0'
min_git_version_regex='2\.(4[2-9]|[5-9][0-9]|[1-9][0-9]{2,})(\..+)?'

print_help() {
	printf 'git istash - Improved version of "git stash" that can handle more corner cases.\n'
	printf '    (See -h of individual sub-commands.)\n'
	printf '\n'
	printf 'This is only a rudimentary help text.\n'
	printf 'Prefer "git help istash" (or "git istash --man") if available.\n'
	printf '\n'
	printf 'Usage: git istash [<sub-command>] [<sub-command argument>...]\n'
	printf '   or: git istash (-h | --help | --man)\n'
	printf '   or: git istash (-V | --version)\n'
	printf '   or: git istash (-c | --continue | --abort | --quit)\n'
	printf '   or: git istash (c | continue | abort | quit)\n'
	printf '\n'
	printf 'Options:\n'
	printf '\t--abort\t\t- Abort apply / pop when one is in progress.\n'
	printf '\t--color[=<when>] - Allow use of ANSI color codes.\n\t\t\t  <when> can be one of always, never, or auto.\n\t\t\t  Omitting the argument is equivalent to always.\n'
	printf '\t--no-color\t- Same as --color=never.\n'
	printf '    -c, --continue\t- Continue apply / pop when one is in progress.\n'
	printf '    -h\t\t\t- Print this help text and exit.\n'
	printf '\t--help\t\t- Show manual page if possible.\n\t\t\t  (If you run it through "git", it will handle this in\n\t\t\t  its own way, which fails on Windows. See --man.)\n'
	printf '\t--man\t\t- Alias for --help that is not intercepted by "git".\n\t\t\t  (Which makes it work on Windows.)\n'
	printf '    -q, --quiet\t\t- Suppress human-readable summaries and information.\n'
	printf '\t--quit\t\t- Like --abort but don'\''t restore the repository state\n\t\t\t  nor move the HEAD.\n'
	printf '    -V, --version\t- Show version information and exit.\n'
	printf '\n'
	printf 'Sub-commands:\n'
	printf '\tabort\t- Alias for "git istash --abort".\n'
	printf '\tapply\t- Analog to "git stash apply --index".\n'
	printf '\tc\t- Alias for "git istash -c". (The same as --continue.)\n'
	printf '\tcontinue- Alias for "git istash --continue".\n'
	printf '\tcreate\t- Analog to "git stash create" (but with options).\n'
	printf '\tpop\t- Analog to "git stash pop --index".\n'
	printf '\tpush\t- Analog to "git stash push". (Default sub-command.)\n'
	printf '\tquit\t- Alias for "git istash --quit".\n'
	printf '\tsave\t- Same as "git istash create" except it stores the stash.\n'
	printf '\tsnatch\t- Same as "git istash push" except it doesn'\''t store the stash.\n'
}

print_version() {
	printf 'git-istash version 1.7.1\n'
	printf 'Author: Piotr Siupa\n'
	printf 'Requires Git in version at least %s\n' "$min_git_version"
}

is_option_alias() { # subcommand
	printf '%s\n' "$1" | grep -Eqx -- 'c(o(n(t(i(n(ue?)?)?)?)?)?)?|abort|quit'
}

exec_subcommand() { # subcommand [arguments...]
	subcommand="$1"
	shift
	subcommand_path="$(dirname "$0")/../lib/git-istash/git-istash-$subcommand"
	if [ ! -f "$subcommand_path" ] || [ ! -x "$subcommand_path" ]
	then
		subcommand_path="$(dirname "$0")/../lib/git-istash/git-istash-push"
		set -- '--_implicit-push_' "$subcommand" "$@"
	fi
	exec sh "$subcommand_path" "$@"
}

show_manual() {
	if [ -f "$(dirname "$0")/../man/man1/git-istash.1" ]
	then
		if (
			cd "$(dirname "$0")/../man"
			MANPATH="$(pwd)"
			export MANPATH
			man git-istash
		)
		then
			return 0
		fi
	fi
	if man git-istash
	then
		return 0
	fi
	printf_fatal 'unable to open the manual entry\n'
	printf_fatal 'falling back to the built-in help text\n'
	fatal '\n'
}

getopt_short_options='chqV'
getopt_long_options='_skip-version-check_,abort,color::,no-color,continue,help,man,quiet,quit,version'
normalized_options="$(get_options_color -U "$getopt_short_options" "$getopt_long_options" "$@")"
eval set -- "$normalized_options"
skip_version_check=n
is_quiet=n
options_to_put_back=''
continuation_option=''
subcommand=''
while true
do
	case "$1" in
	--_skip-version-check_)
		skip_version_check=y
		;;
	--color)
		shift
		set_color_for_all "$1"
		;;
	--no-color)
		set_color_for_all 'never'
		;;
	-h)
		while [ "$1" != '--' ]
		do
			shift
		done
		shift
		if [ $# -eq 0 ] || is_option_alias "$1"
		then
			print_help
			exit 0
		else
			exec_subcommand "$1" '-h'
		fi
		;;
	--help)
		if [ "$1" = '--help' ]
		then
			exec git istash --help
		fi
		;;
	--man)
		if show_manual
		then
			exit 0
		else
			shift
			set -- '-h' "$@"
			continue
		fi
		;;
	-q|--quiet)
		is_quiet=y
		options_to_put_back="$options_to_put_back $(printf '%s' "$1" | escape_for_shell)"
		;;
	-V|--version)
		print_version
		exit 0
		;;
	-c|--continue|--abort|--quit)
		options_to_put_back="$options_to_put_back $(printf '%s' "$1" | escape_for_shell)"
		continuation_option="$1"
		;;
	--)
		shift
		if [ $# -ne 0 ] && printf '%s' "$1" | grep -E -q '^[^-]'
		then
			if is_option_alias "$1"
			then
				if [ "$(printf '%s' "$1" | head -c1)" = 'c' ]
				then
					shift
					set -- 'continue' "$@"
				fi
				option_alias="$1"
				shift
				set -- "--$option_alias" '--' "$@"
				unset option_alias
				continue
			else
				subcommand="$1"
				shift
				break
			fi
		else
			break
		fi
		;;
	esac
	shift
done
eval set -- "$options_to_put_back" '"$@"'

if [ -z "$subcommand" ]
then
	if [ -z "$continuation_option" ]
	then
		subcommand='push'
		set -- '--_implicit-push_' "$@"
	else
		. "$(dirname "$0")/../lib/git-istash/git-istash-commons"
		data_files="$(find_data_files)"
		case "$data_files" in
			nothing)
				error 'no istash operation in progress\n'
				;;
			apply)
				subcommand='apply'
				;;
			pop)
				subcommand='pop'
				;;
			error-*)
				if [ "$continuation_option" = '--quit' ]
				then
					subcommand="$(printf '%s' "$data_files" | tail -c+7)"
				else
					print_error_for_data_files_check "$data_files" 'push'
					exit 1
				fi
				;;
		esac
	fi
fi

git_version="$(git --version | head -n 1 | grep -Eo '[[:graph:]]+$')"
if [ "$skip_version_check" = n ] && ! printf '%s' "$git_version" | grep -Exq "$min_git_version_regex"
then
	fatal 'the current Git version (%s) is less than minimum required (%s)\n' "$git_version" "$min_git_version"
fi

exec_subcommand "$subcommand" "$@"

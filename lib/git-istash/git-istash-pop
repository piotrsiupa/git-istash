#!/usr/bin/env sh

set -eu

. "$(dirname "$0")/git-istash-commons"
. "$(dirname "$0")/git-istash-io"

print_help() {
	printf 'git istash pop - Improved version of "git stash pop" that can handle conflicts\n    without loosing information about the files in index.\n'
	printf '\n'
	printf 'This is only a rudimentary help text. Prefer "git help istash" if available.\n'
	printf '\n'
	printf 'Usage: git istash pop [<option>...] [<stash>]\n'
	printf '   or: git istash pop (-c | --continue | --abort | --quit)\n'
	printf '   or: git istash pop -h\n'
	printf '\n'
	printf 'Options:\n'
	printf '\t--abort\t\t- Abort the previous operation and return the repository\n\t\t\t  to the state before it started.\n'
	printf '\t--color[=<when>] - Allow use of ANSI color codes.\n\t\t\t  <when> can be one of always, never, or auto.\n\t\t\t  Omitting the argument is equivalent to always.\n'
	printf '\t--no-color\t- Same as --color=never.\n'
	printf '    -c, --continue\t- Resume the previous operation.\n\t\t\t  (Conflicts need to be resolved before that.)\n'
	printf '    -h\t\t\t- Print this help text and exit.\n'
	printf '\t--quit\t\t- Abort the operation but don'\''t restore the repository\n\t\t\t  state nor move the HEAD.\n'
}

save_data() {
	printf '%s\n' "$stash" >"$stash_data_file"
}
load_stash_data() { # subcommand
	if [ "$(wc -l <"$stash_data_file")" -ne 1 ]
	then
		printf_fatal \''git istash pop'\'' seems to be in progress but the data files are broken\n'
		printf_fatal \''%s'\'' doesn'\''t have exactly 1 line\n' "$stash_data_file"
		print_broken_operation_hint 'pop' "$1"
		fatal
	fi
	stash="$(cat "$stash_data_file")"
	if ! [ "$stash" -eq "$stash" ] 2>/dev/null || [ "$stash" -lt 0 ]
	then
		printf_fatal \''git istash pop'\'' seems to be in progress but the data files are broken\n'
		printf_fatal \''%s'\'' doesn'\''t contain a positive integer\n' "$stash_data_file"
		print_broken_operation_hint 'pop' "$1"
		fatal
	fi
	if [ "$stash" -ge "$(git rev-list --walk-reflogs --count --ignore-missing refs/stash)" ]
	then
		printf_fatal \''git istash pop'\'' seems to be in progress but the data files are broken\n'
		printf_fatal \''%s'\'' contains an invalid stash number\n' "$stash_data_file"
		print_broken_operation_hint 'pop' "$1"
		fatal
	fi
}
load_data() { # subcommand
	load_stash_data "$1"
}
delete_data() {
	rm -f "$stash_data_file"
}

check_args_for_pop() { # max_free_args args...
	check_args 'istash pop' "$@"
}

end_with_success() {
	delete_data
	git stash drop "$stash"
	printf '\nSuccessfully popped the stash\n'
}

check_stash_for_pop() {
	if [ "$stash" -eq "$stash" ] 2>/dev/null
	then
		:
	else
		error 'can only pop '\''refs/stash'\'' or entries of its reflog\n'
	fi
}

check_data_files() { # resume abort quit
	operation_in_progress="$(find_data_files)"
	case "$operation_in_progress" in
		pop)
			if [ "$1" = y ] || [ "$2" = y ] || [ "$3" = y ] ; then return 0 ; fi
			print_error_for_data_files_check "$operation_in_progress" 'pop'
			error
			;;
		apply)
			if [ "$2" = y ] || [ "$3" = y ] ; then return 0 ; fi
			print_error_for_data_files_check "$operation_in_progress" 'pop'
			error
			;;
		error-*)
			if [ "$3" = y ] ; then return 0 ; fi
			print_error_for_data_files_check "$operation_in_progress" 'pop'
			error
			;;
		nothing)
			if [ "$1" = n ] && [ "$2" = n ] && [ "$3" = n ] ; then return 0 ; fi
			error 'no istash pop in progress\n'
			;;
	esac
}

run_apply() { # args...
	sh "$lib_dir/git-istash-apply" --_called-from-pop_ "$@"
}

do_start() { # args...
	check_args_for_pop 1 "$@"
	check_data_files n n n
	check_other_git_commands_state
	find_stash "$@"
	check_stash_for_pop
	save_data
	if run_apply -- "$@"
	then
		end_with_success
	elif [ $? -eq 2 ]
	then
		return 2
	else
		delete_data
		return 1
	fi
}

do_continue() { # args...
	check_args_for_pop 0 "$@"
	check_data_files y n n
	load_data 'pop'
	run_apply --continue
	end_with_success
}

do_abort() { # args...
	check_args_for_pop 0 "$@"
	check_data_files n y n
	run_apply --abort
	delete_data
}

do_quit() { # args...
	check_args_for_pop 0 "$@"
	check_data_files n n y
	run_apply --quit
	delete_data
}

do_pop() { # args...
	if [ "$continue_set" = y ]
	then
		do_continue "$@"
	elif [ "$abort_set" = y ]
	then
		do_abort "$@"
	elif [ "$quit_set" = y ]
	then
		do_quit "$@"
	else
		do_start "$@"
	fi
}

getopt_short_options='chq'
getopt_long_options='abort,color::,no-color,continue,quit'
normalized_options="$(get_options_color "$getopt_short_options" "$getopt_long_options" "$@")"
eval set -- "$normalized_options"
abort_set=n
continue_set=n
quit_set=n
while true
do
	case "$1" in
	--abort)
		abort_set=y
		;;
	--color)
		shift
		set_color_for_all "$1"
		;;
	--no-color)
		set_color_for_all 'never'
		;;
	-c|--continue)
		continue_set=y
		;;
	-h)
		print_help
		exit 0
		;;
	-q|--quit)
		quit_set=y
		;;
	--)
		shift
		break
		;;
	esac
	shift
done
if [ $continue_set = y ] && [ $abort_set = y ] && [ $quit_set = y ]
then
	error 'you can choose continue, abort or quit at your discretion but the rule is that you can only have one\n'
fi
if [ $abort_set = y ] && [ $quit_set = y ]
then
	error 'either abort or quit; there is no middle road\n'
fi
if [ $continue_set = y ] && [ $abort_set = y ]
then
	error 'unclear whether to continue aborting or to abort continuing\n'
fi
if [ $continue_set = y ] && [ $quit_set = y ]
then
	error 'unclear whether to continue quitting or to quit continuing\n'
fi

lib_dir="$(cd "$(dirname "$0")" ; pwd)"
cd "$(git rev-parse --show-toplevel)"
stash_data_file="$(make_stash_data_file_path)"
do_pop "$@"

# A set of utility functions for istash scripts.

#shellcheck disable=SC2034
tab='	'
nl='
'

if command -v od 1>/dev/null 2>&1
then
	convert_to_octal() {
		#shellcheck disable=SC1003
		od -bvAn | tr ' ' '\\' | tr -d '\n'
	}
else
	convert_to_octal() {
		hexdump -ve'"\\" /1 "%03o"'
	}
fi
convert_to_octal_lines() {
	#shellcheck disable=SC1003
	convert_to_octal \
	| sed -E 's/\\000/\'"$nl"'/g'
}

make_data_file_path() { # name
	git rev-parse --git-dir | tr -d '\n'
	printf '/istash %s' "$1" | tr ' a-z' '_A-Z'
}
make_target_data_file_path() {
	make_data_file_path 'target'
}
make_working_dir_sha_file_path() {
	make_data_file_path 'working-dir'
}
make_stash_data_file_path() {
	make_data_file_path 'stash'
}

find_data_files() {
	target_data_file_path="$(make_target_data_file_path)"
	working_dir_sha_file_path="$(make_working_dir_sha_file_path)"
	stash_data_file_path="$(make_stash_data_file_path)"
	if [ -f "$target_data_file_path" ] || [ -f "$working_dir_sha_file_path" ] || [ -f "$stash_data_file_path" ]
	then
		if [ -f "$target_data_file_path" ] && [ -f "$working_dir_sha_file_path" ]
		then
			if [ -f "$stash_data_file_path" ]
			then
				printf 'pop'
			else
				printf 'apply'
			fi
		else
			if [ -f "$stash_data_file_path" ]
			then
				printf 'error-pop'
			else
				printf 'error-apply'
			fi
		fi
	else
		printf 'nothing'
	fi
}

check_args() { # max_free_args args...
	_script_name="$1"
	_max_free_args="$2"
	shift 2
	if [ $# -gt "$_max_free_args" ]
	then
		printf_error 'too many arguments\n'
		help_hint "$_script_name"
		error
	fi
}

check_other_git_commands_state() {
	other_git_command=''
	git_dir="$(git rev-parse --git-dir)"
	if [ -e "$git_dir/rebase-apply" ] || [ -e "$git_dir/rebase-merge" ]
	then
		other_git_command='rebase'
	elif [ -e "$git_dir/CHERRY_PICK_HEAD" ]
	then
		other_git_command='cherry-pick'
	elif [ -e "$git_dir/REVERT_HEAD" ]
	then
		other_git_command='revert'
	elif [ -e "$git_dir/MERGE_HEAD" ]
	then
		other_git_command='merge'
	elif [ -e "$git_dir/BISECT_START" ]
	then
		other_git_command='bisect'
	fi
	if [ -n "$other_git_command" ]
	then
		printf_error 'there is currently '\''git %s'\'' in progress\n' "$other_git_command"
		hint 'FinalizeOther' 'finalize it before running '\''git istash'\''\n'
		error
	fi
}

check_data_files() { # operation
	current_operation="$(find_data_files)"
	if printf '%s\n' "$current_operation" | grep -E -q '^error-'
	then
		print_error_for_data_files_check "$current_operation" "$1"
		fatal
	elif [ "$current_operation" != 'nothing' ]
	then
		print_error_for_data_files_check "$current_operation" "$1"
		fatal
	fi
}

get_stash_commit() { # stash
	if [ "$1" -eq "$1" ] 2>/dev/null
	then
		printf '%s' "stash@{$1}"
	else
		printf '%s' "$1"
	fi
}

find_stash() { # [arg]
	if [ $# -eq 0 ] || [ "$1" = 'stash' ]
	then
		stash=0
	elif [ "$1" -eq "$1" ] 2>/dev/null
	then
		if [ "$1" -ge 0 ]
		then
			stash=$1
		else
			stash=$(($(git rev-list --walk-reflogs --count --ignore-missing refs/stash) + $1))
		fi
	elif printf '%s' "$1" | grep -xqE 'stash\^\{/.*\}'
	then
		stash_text="$(printf '%s' "$1" | sed -E 's/^stash\^\{\/(.*)\}$/\1/')"
		stash_sha="$(git rev-list --walk-reflogs --grep-reflog="$stash_text" --ignore-missing refs/stash | head -n1)"
		stash="$(($(git rev-list --walk-reflogs refs/stash | grep -Fxn "$stash_sha" | cut -d: -f1) - 1))"
	elif printf '%s' "$1" | grep -xqE 'stash@\{[0-9]+\}'
	then
		stash="$(printf '%s' "$1" | sed -E 's/^stash@\{(.*)\}$/\1/')"
	else
		stash="$1"
	fi
	check_stash "$stash"
}

check_stash() { # stash
	stash_commit="$(get_stash_commit "$1")"
	if ! git rev-parse --quiet --verify "$stash_commit^{commit}" 1>/dev/null
	then
		error 'no commit '\''%s'\''\n' "$stash_commit"
	fi
	parents_num="$(git rev-list --no-walk --count "$stash_commit^@")"
	if [ "$parents_num" -lt 2 ] || [ "$parents_num" -gt 3 ]
	then
		fatal \''%s'\'' doesn'\''t have 2 or 3 parents required to be a stash\n' "$stash_commit"
	fi
	if [ "$parents_num" -eq 3 ] && [ "$(git rev-list --no-walk --count "$stash_commit^3^@")" -ne 0 ]
	then
		fatal \''%s^3'\'' have parents unlike in a stash\n' "$stash_commit"
	fi
	if [ "$(git rev-list --no-walk --count "$stash_commit^2^@")" -ne 1 ]
	then
		fatal \''%s^2'\'' doesn'\''t have one parent like in a stash\n' "$stash_commit"
	fi
	if [ "$(git rev-parse "$stash_commit^1")" != "$(git rev-parse "$stash_commit^2^")" ]
	then
		fatal \''%s^1'\'' isn'\''t the parent of '\''%s^2'\'' like in a stash\n' "$stash_commit" "$stash_commit"
	fi
	correct_commit_msgs=0
	if [ "$parents_num" -eq 3 ] && git rev-list --format='%B' --max-count=1 "$stash_commit^3" | head -n 2 | tail -n 1 | grep -qE '^untracked files on .+:'
	then
		correct_commit_msgs=$((correct_commit_msgs + 1))
	fi
	if git rev-list --format='%B' --max-count=1 "$stash_commit^2" | head -n 2 | tail -n 1 | grep -qE '^index on .+:'
	then
		correct_commit_msgs=$((correct_commit_msgs + 1))
	fi
	if git rev-list --format='%B' --max-count=1 "$stash_commit" | head -n 2 | tail -n 1 | grep -qE '^(WIP on|On) .+:'
	then
		correct_commit_msgs=$((correct_commit_msgs + 1))
	fi
	if [ $correct_commit_msgs -ne "$parents_num" ]
	then
		printf_fatal 'some of '\''%s'\'' commits don'\''t have correct messages for a stash\n' "$stash_commit"
		printf_fatal 'it may not be a stash entry or it may be damaged\n'
		fatal
	fi
}

find_current_branch() {
	if git rev-parse HEAD >/dev/null 2>&1
	then
		current_branch="$(git rev-parse --abbrev-ref HEAD)"
		curr_branch_type='normal'
		if [ "$current_branch" = 'HEAD' ]
		then
			current_branch="$(git rev-parse HEAD)"
			curr_branch_type='detached'
		fi
	else
		current_branch="$(git branch --show-current)"
		#shellcheck disable=SC2034
		curr_branch_type='orphan'
	fi
}

are_there_conflicts() {
	git status --porcelain | grep -qE '^(.U|U.|AA) '
}

parse_git_bool() { # boolean_to_parse
     test "$(git -c 'istash.bool-parsing-tmp-value'="$1" config --get --type=bool 'istash.bool-parsing-tmp-value' 2>/dev/null)" = 'true'
}

set_getopt_options_from_command() { # full_command_name
	getopt_short_options="$(sed -E -n 's/^[[:blank:]]*getopt_short_options='\''([^'\'']+)'\''[[:blank:]]*$/\1/p' "$(dirname "$0")/$1")"
	getopt_long_options="$(sed -E -n 's/^[[:blank:]]*getopt_long_options='\''([^'\'']+)'\''[[:blank:]]*$/\1/p' "$(dirname "$0")/$1")"
	if [ "$(printf '%s\n' "$getopt_short_options" | wc -l)" -ne 1 ] || [ "$(printf '%s\n' "$getopt_long_options" | wc -l)" -ne 1 ]
	then
		# Not tested because it cannot be triggered. It's here in a case something gets broken by a future change.
		fatal 'cannot determine if there is option '\''-h'\'' in the arguments\n'
	fi
}

check_for_option_h_in_command() ( # full_command_name option...
	set -e
	if ! set_getopt_options_from_command "$1"
	then
		return 0  # Fall back to showing help, to not accidentaly break the repository.
	fi
	shift
	normalized_options="$(get_options_color "$getopt_short_options" "$getopt_long_options" "$@" 2>/dev/null)"
	eval set -- "$normalized_options"
	while [ $# -ne 0 ]
	do
		if [ "$1" = '-h' ]
		then
			return 0
		fi
		shift
	done
	return 1
)

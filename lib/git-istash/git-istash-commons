# A set of utility functions for istash scripts.

is_color_allowed() { # stream_num
	case "$(git config --get color.ui)" in
		always|true|1) return 0 ;;
		never|false|0) return 1 ;;
		*)             test -t "$1" ;;
	esac
}

# Runs "printf" with the given args only if color is allowed for given stream.
printf_color() { # stream_num args...
	if is_color_allowed "$1"
	then
		shift
		#shellcheck disable=SC2059
		printf "$@"
	fi
}

is_color_enabled() { # config_variable...
	if [ $# -eq 0 ]
	then
		# This is here to not forget a value during the developoment.
		printf 'fatal: not enough arguments for is_color_enabled\n' 1>&2
		return 128
	fi
	while [ $# -gt 1 ] && ! git config --get "$1" 1>/dev/null
	do
		shift
	done
	git config --get-colorbool "$1"
}

get_color() { # default_value config_variable...
	if [ $# -eq 0 ]
	then
		# This is here to not forget a value during the developoment.
		printf 'fatal: not enough arguments for get_color\n' 1>&2
		return 128
	fi
	default_color="$1"
	shift
	while [ $# -gt 1 ] && ! git config --get "$1" 1>/dev/null
	do
		shift
	done
	git config --get-color "${1-}" "$default_color"
}

# Applies color to each line from stdin.
# The arguments are passed to "get_color".
color_lines() { # default_value config_variable
	set -e
	color_escape_code="$(get_color "$@")"
	reset_escape_code="$(git config --get-color '' 'reset')"
	sed -E "/./s/^.*\$/$color_escape_code&$reset_escape_code/"
}

if command -v od 1>/dev/null 2>&1
then
	convert_to_octal() {
		#shellcheck disable=SC1003
		od -bvAn | tr ' ' '\\' | tr -d '\n'
	}
else
	convert_to_octal() {
		hexdump -ve'"\\" /1 "%03o"'
	}
fi

make_data_file_path() { # name
	git rev-parse --git-dir | tr -d '\n'
	printf '/istash %s' "$1" | tr ' a-z' '_A-Z'
}
make_target_data_file_path() {
	make_data_file_path 'target'
}
make_working_dir_sha_file_path() {
	make_data_file_path 'working-dir'
}
make_stash_data_file_path() {
	make_data_file_path 'stash'
}

find_data_files() {
	target_data_file_path="$(make_target_data_file_path)"
	working_dir_sha_file_path="$(make_working_dir_sha_file_path)"
	stash_data_file_path="$(make_stash_data_file_path)"
	if [ -f "$target_data_file_path" ] || [ -f "$working_dir_sha_file_path" ] || [ -f "$stash_data_file_path" ]
	then
		if [ -f "$target_data_file_path" ] && [ -f "$working_dir_sha_file_path" ]
		then
			if [ -f "$stash_data_file_path" ]
			then
				printf 'pop'
			else
				printf 'apply'
			fi
		else
			if [ -f "$stash_data_file_path" ]
			then
				printf 'error-pop'
			else
				printf 'error-apply'
			fi
		fi
	else
		printf 'nothing'
	fi
}

check_args() { # max_free_args args...
	_script_name="$1"
	_max_free_args="$2"
	shift 2
	if [ $# -gt "$_max_free_args" ]
	then
		{
			printf 'error: too many arguments\n'
			printf 'hint: type '\''git %s --help'\'' for detailed information\n' "$_script_name"
			printf 'hint: or '\''git %s -h'\'' for a short help text\n' "$_script_name"
		} 1>&2
		return 1
	fi
}

check_other_git_commands_state() {
	other_git_command=''
	git_dir="$(git rev-parse --git-dir)"
	if [ -e "$git_dir/rebase-apply" ] || [ -e "$git_dir/rebase-merge" ]
	then
		other_git_command='rebase'
	elif [ -e "$git_dir/CHERRY_PICK_HEAD" ]
	then
		other_git_command='cherry-pick'
	elif [ -e "$git_dir/REVERT_HEAD" ]
	then
		other_git_command='revert'
	elif [ -e "$git_dir/MERGE_HEAD" ]
	then
		other_git_command='merge'
	elif [ -e "$git_dir/BISECT_START" ]
	then
		other_git_command='bisect'
	fi
	if [ -n "$other_git_command" ]
	then
		printf 'error: there is currently '\''git %s'\'' in progress\n' "$other_git_command"
		printf 'hint: finalize it before running '\''git istash'\'
		return 1
	fi 1>&2
}

print_broken_operation_hint() { # called_operation
	printf_color 2 '\033[33m'
	if printf '%s' "$1" | grep -E -q '^-'
	then
		printf 'hint: fix the problems and rerun '\''git istash %s'\''\n' "$1"
	else
		printf 'hint: fix the problem and finalize that operation before starting a new one\n'
	fi
	printf 'hint: or run '\''git istash --quit'\'' to forcefully cancel it\n'
	printf_color 2 '\033[39m'
} 1>&2

print_error_for_data_files_check() { # current_operation called_operation
	printf_color 2 '\033[31m'
	if printf '%s\n' "$1" | grep -E -q '^error-'
	then
		operation_in_progress="$(printf '%s' "$1" | tail -c +7)"
		printf 'fatal: '\''git istash %s'\'' seems to be in progress but the data files are broken\n' "$operation_in_progress"
		if [ -f "$(make_target_data_file_path)" ]
		then
			printf 'fatal: '\''%s'\'' is missing\n' "$(make_working_dir_sha_file_path)"
		elif [ -f "$(make_working_dir_sha_file_path)" ]
		then
			printf 'fatal: '\''%s'\'' is missing\n' "$(make_target_data_file_path)"
		else
			printf 'fatal: '\''%s'\'' and '\''%s'\'' are missing\n' "$(make_target_data_file_path)" "$(make_working_dir_sha_file_path)"
		fi
		print_broken_operation_hint "$2"
	elif [ "$1" != 'nothing' ]
	then
		printf 'error: there is currently '\''git istash %s'\'' in progress\n' "$1"
		printf 'hint: use '\''git istash --continue'\'' or '\''git istash --abort'\''\n'
	fi
	printf_color 2 '\033[39m'
} 1>&2

check_data_files() { # operation
	current_operation="$(find_data_files)"
	if printf '%s\n' "$current_operation" | grep -E -q '^error-'
	then
		print_error_for_data_files_check "$current_operation" "$1"
		return 1
	elif [ "$current_operation" != 'nothing' ]
	then
		print_error_for_data_files_check "$current_operation" "$1"
		return 1
	fi
}

get_stash_commit() { # stash
	if [ "$1" -eq "$1" ] 2>/dev/null
	then
		printf '%s' "stash@{$1}"
	else
		printf '%s' "$1"
	fi
}

find_stash() { # [arg]
	if [ $# -eq 0 ] || [ "$1" = 'stash' ]
	then
		stash=0
	elif [ "$1" -eq "$1" ] 2>/dev/null
	then
		if [ "$1" -ge 0 ]
		then
			stash=$1
		else
			stash=$(($(git rev-list --walk-reflogs --count --ignore-missing refs/stash) + $1))
		fi
	elif printf '%s' "$1" | grep -xqE 'stash\^\{/.*\}'
	then
		stash_text="$(printf '%s' "$1" | sed -E 's/^stash\^\{\/(.*)\}$/\1/')"
		stash_sha="$(git rev-list --walk-reflogs --grep-reflog="$stash_text" --ignore-missing refs/stash | head -n1)"
		stash="$(($(git rev-list --walk-reflogs refs/stash | grep -Fxn "$stash_sha" | cut -d: -f1) - 1))"
	elif printf '%s' "$1" | grep -xqE 'stash@\{[0-9]+\}'
	then
		stash="$(printf '%s' "$1" | sed -E 's/^stash@\{(.*)\}$/\1/')"
	else
		stash="$1"
	fi
	check_stash "$stash"
}

check_stash() { # stash
	stash_commit="$(get_stash_commit "$1")"
	if ! git rev-parse --quiet --verify "$stash_commit^{commit}" 1>/dev/null
	then
		printf 'error: no commit '\''%s'\''\n' "$stash_commit" 1>&2
		return 1
	fi
	parents_num="$(git rev-list --no-walk --count "$stash_commit^@")"
	if [ "$parents_num" -lt 2 ] || [ "$parents_num" -gt 3 ]
	then
		printf 'fatal: '\''%s'\'' doesn'\''t have 2 or 3 parents required to be a stash\n' "$stash_commit" 1>&2
		return 1
	fi
	if [ "$parents_num" -eq 3 ] && [ "$(git rev-list --no-walk --count "$stash_commit^3^@")" -ne 0 ]
	then
		printf 'fatal: '\''%s^3'\'' have parents unlike in a stash\n' "$stash_commit" 1>&2
		return 1
	fi
	if [ "$(git rev-list --no-walk --count "$stash_commit^2^@")" -ne 1 ]
	then
		printf 'fatal: '\''%s^2'\'' doesn'\''t have one parent like in a stash\n' "$stash_commit" 1>&2
		return 1
	fi
	if [ "$(git rev-parse "$stash_commit^1")" != "$(git rev-parse "$stash_commit^2^")" ]
	then
		printf 'fatal: '\''%s^1'\'' isn'\''t the parent of '\''%s^2'\'' like in a stash\n' "$stash_commit" "$stash_commit" 1>&2
		return 1
	fi
	correct_commit_msgs=0
	if [ "$parents_num" -eq 3 ] && git rev-list --format='%B' --max-count=1 "$stash_commit^3" | head -n 2 | tail -n 1 | grep -qE '^untracked files on .+:'
	then
		correct_commit_msgs=$((correct_commit_msgs + 1))
	fi
	if git rev-list --format='%B' --max-count=1 "$stash_commit^2" | head -n 2 | tail -n 1 | grep -qE '^index on .+:'
	then
		correct_commit_msgs=$((correct_commit_msgs + 1))
	fi
	if git rev-list --format='%B' --max-count=1 "$stash_commit" | head -n 2 | tail -n 1 | grep -qE '^(WIP on|On) .+:'
	then
		correct_commit_msgs=$((correct_commit_msgs + 1))
	fi
	if [ $correct_commit_msgs -ne "$parents_num" ]
	then
		printf 'fatal: some of '\''%s'\'' commits don'\''t have correct messages for a stash\n' "$stash_commit" 1>&2
		printf 'fatal: it may not be a stash entry or it may be damaged\n' 1>&2
		return 1
	fi
}

find_current_branch() {
	if git rev-parse HEAD >/dev/null 2>&1
	then
		current_branch="$(git rev-parse --abbrev-ref HEAD)"
		curr_branch_type='normal'
		if [ "$current_branch" = 'HEAD' ]
		then
			current_branch="$(git rev-parse HEAD)"
			curr_branch_type='detached'
		fi
	else
		current_branch="$(git branch --show-current)"
		#shellcheck disable=SC2034
		curr_branch_type='orphan'
	fi
}

are_there_conflicts() {
	git status --porcelain | grep -qE '^(.U|U.|AA) '
}

parse_git_bool() { # boolean_to_parse
     test "$(git -c 'istash.bool-parsing-tmp-value'="$1" config --get --type=bool 'istash.bool-parsing-tmp-value' 2>/dev/null)" = 'true'
}

set_getopt_options_from_make_command() {
	getopt_short_options="$(sed -E -n 's/^\s*getopt_short_options='\''([^'\'']+)'\''\s*$/\1/p' "$(dirname "$0")/git-istash-make-stash")"
	getopt_long_options="$(sed -E -n 's/^\s*getopt_long_options='\''([^'\'']+)'\''\s*$/\1/p' "$(dirname "$0")/git-istash-make-stash")"
	if [ "$(printf '%s\n' "$getopt_short_options" | wc -l)" -ne 1 ] || [ "$(printf '%s\n' "$getopt_long_options" | wc -l)" -ne 1 ]
	then
		# Not tested because it cannot be triggered. It's here in a case something gets broken by a future change.
		printf 'fatal: cannot determine if there is option '\''-h'\'' in the arguments\n' 1>&2
		return 1
	fi
}

check_for_option_h_in_make_command() ( # option...
	if ! set_getopt_options_from_make_command
	then
		return 0  # Fall back to showing help, to not accidentaly break the repository.
	fi
	normalized_options="$(get_options "$getopt_short_options" "$getopt_long_options" "$@" 2>/dev/null)"
	eval set -- "$normalized_options"
	while [ $# -ne 0 ]
	do
		if [ "$1" = '-h' ]
		then
			return 0
		fi
		shift
	done
	return 1
)

#!/usr/bin/env sh

set -eu

. "$(dirname "$0")/git-istash-commons"
. "$(dirname "$0")/git-istash-io"
. "$(dirname "$0")/git-istash-vanilla-format"

print_help() {
	printf 'git istash apply - Improved version of "git stash apply" that can handle\n    conflicts without loosing information about the files in index.\n'
	printf '\n'
	printf 'This is only a rudimentary help text. Prefer "git help istash" if available.\n'
	printf '\n'
	printf 'Usage: git istash apply [<option>...] [<stash>]\n'
	printf '   or: git istash apply (-c | --continue | --abort | --quit)\n'
	printf '   or: git istash apply -h\n'
	printf '\n'
	printf 'Options:\n'
	printf '\t--abort\t\t- Abort the previous operation and return the repository\n\t\t\t  to the state before it started.\n'
	printf '\t--color[=<when>] - Allow use of ANSI color codes.\n\t\t\t  <when> can be one of always, never, or auto.\n\t\t\t  Omitting the argument is equivalent to always.\n'
	printf '\t--no-color\t- Same as --color=never.\n'
	printf '    -c, --continue\t- Resume the previous operation.\n\t\t\t  (Conflicts need to be resolved before that.)\n'
	printf '    -h\t\t\t- Print this help text and exit.\n'
	printf '    -q, --quiet\t\t- Suppress human-readable summaries and information.\n'
	printf '\t--quit\t\t- Abort the operation but don'\''t restore the repository\n\t\t\t  state nor move the HEAD.\n'
	printf '\t--summary=<mode> - Set summary to "complete" / "non-ignored" / "off".\n'
}

get_sub_command_name() {
	if [ "$is_pop" = n ]
	then
		printf 'apply'
	else
		printf 'pop'
	fi
}

save_data() {
	target_data="$(if [ "$curr_branch_type" = 'orphan' ] ; then printf '~' ; fi ; printf '%s' "$current_branch")"
	printf '%s\n' "$target_data" >"$target_data_file"
	
	printf '%s\n' "$working_dir_changes_sha" >"$working_dir_sha_file"
}
load_target_data() { # subcommand
	if [ "$(wc -l <"$target_data_file")" -ne 1 ]
	then
		printf_fatal \''git istash %s'\'' seems to be in progress but the data files are broken\n' "$(get_sub_command_name)"
		printf_fatal \''%s'\'' doesn'\''t have exactly 1 line\n' "$target_data_file"
		print_broken_operation_hint "$1"
		fatal
	fi
	current_branch="$(cat "$target_data_file")"
	if printf '%s' "$current_branch" | grep -qE '^~'
	then
		current_branch="$(printf '%s' "$current_branch" | cut -c2-)"
		curr_branch_type='orphan'
	else
		curr_branch_type='normal'
	fi
	if ! git rev-parse --quiet --verify "$current_branch^{commit}" 1>/dev/null
	then
		printf_fatal \''git istash %s'\'' seems to be in progress but the data files are broken\n' "$(get_sub_command_name)"
		printf_fatal \''%s'\'' contains an invalid commit hash\n' "$target_data_file"
		print_broken_operation_hint "$1"
		fatal
	fi
	if [ "$curr_branch_type" != 'orphan' ] && [ "$(git rev-parse "$current_branch")" = "$current_branch" ]
	then
		curr_branch_type='detached'
	fi
}
load_working_dir_data() { # subcommand
	if [ "$(wc -l <"$working_dir_sha_file")" -ne 1 ]
	then
		printf_fatal \''git istash %s'\'' seems to be in progress but the data files are broken\n' "$(get_sub_command_name)"
		printf_fatal \''%s'\'' doesn'\''t have exactly 1 line\n' "$working_dir_sha_file"
		print_broken_operation_hint "$1"
		fatal
	fi
	working_dir_changes_sha="$(cat "$working_dir_sha_file")"
	if ! git rev-parse --quiet --verify "$working_dir_changes_sha^{commit}" 1>/dev/null
	then
		printf_fatal \''git istash %s'\'' seems to be in progress but the data files are broken\n' "$(get_sub_command_name)"
		printf_fatal \''%s'\'' contains an invalid commit hash\n' "$working_dir_sha_file"
		print_broken_operation_hint "$1"
		fatal
	fi
}
load_data() { # subcommand
	load_target_data "$1"
	load_working_dir_data "$1"
}
delete_data() {
	rm -f "$target_data_file" "$working_dir_sha_file"
}

check_args_for_apply() { # max_free_args args...
	check_args 'istash apply' "$@"
}

put_files_into_working_copy() { # untracked_changes_sha non_staged_changes_sha staged_changes_sha
	git restore --quiet --source="$3" -- . 2>/dev/null || true
	git add -- .
	git restore --quiet --source="$1" -- . 2>/dev/null || true
	git --no-literal-pathspecs ls-tree -r --name-only "$2" -z :/ \
	| xargs -r0 -- git --literal-pathspecs add --intent-to-add --
}

print_changes_summary() {
	summary_mode="$(get_summary_mode)"
	if [ "$summary_mode" = 'off' ]
	then
		return
	fi
	if is_color_enabled_for_summary
	then
		header_color_escape_code="$(get_color_for_summary 'header')"
		updated_color_escape_code="$(get_color_for_summary 'updated')"
		changed_color_escape_code="$(get_color_for_summary 'changed')"
		untracked_color_escape_code="$(get_color_for_summary 'untracked')"
		reset_escape_code="$(get_color 'reset')"
	else
		header_color_escape_code=''
		updated_color_escape_code=''
		changed_color_escape_code=''
		untracked_color_escape_code=''
		reset_escape_code=''
	fi
	printf '\n%sChanges made to the working directory:%s\n' "$header_color_escape_code" "${header_color_escape_code:+$reset_escape_code}"
	all_changes="$(
		set -eu
		{
			git diff --no-renames --name-only -z "$working_dir_changes_sha~2" "$staged_changes_sha"
			git diff --no-renames --name-only -z "$working_dir_changes_sha~1" "$non_staged_changes_sha"
			git diff --no-renames --name-only -z "$working_dir_changes_sha~0" "$untracked_changes_sha"
			if [ "$summary_mode" = 'complete' ]
			then
				git ls-files --no-cached --no-deleted --no-modified --others --no-ignored --no-stage --no-killed --exclude-standard -z
				git ls-files --no-cached --no-deleted --no-modified --others --ignored --no-stage --no-killed --exclude-standard -z
			fi
		} \
		| convert_to_octal_lines \
		| sort -u \
		| while read -r file
		do
			# The abbreviations used here:
			# the 1st letter is "old" / "new"
			# the 2nd letter is "index" / "tracked" / "untracked".
			oi_sha="$(
				printf -- "%s:$file" "$working_dir_changes_sha~2" \
				| xargs -0 -- git --literal-pathspecs rev-parse 2>/dev/null \
				| tr -d -c '0-9A-Za-z:' \
				| sed -E 's/^.*:.*$/0000000000000000000000000000000000000000/'
			)"
			ot_sha="$(
				printf -- "%s:$file" "$working_dir_changes_sha~1" \
				| xargs -0 -- git --literal-pathspecs rev-parse 2>/dev/null \
				| tr -d -c '0-9A-Za-z:' \
				| sed -E 's/^.*:.*$/0000000000000000000000000000000000000000/'
			)"
			ou_sha="$(
				printf -- "%s:$file" "$working_dir_changes_sha~0" \
				| xargs -0 -- git --literal-pathspecs rev-parse 2>/dev/null \
				| tr -d -c '0-9A-Za-z:' \
				| sed -E 's/^.*:.*$/0000000000000000000000000000000000000000/'
			)"
			ni_sha="$(
				#shellcheck disable=SC2059
				if ! printf -- "$file" \
					| xargs -0 -- git --literal-pathspecs status --porcelain -- \
					| grep -E -q '^.A'
				then
					#shellcheck disable=SC2059
					printf -- "$file" \
					| xargs -0 -- git --literal-pathspecs ls-files -s -- \
					| cut -d' ' -f2
				else
					#shellcheck disable=SC2059
					printf -- "$file" \
					| xargs -0 -- git --literal-pathspecs status --porcelain=2 -- \
					| head -n1 \
					| cut -d' ' -f8
				fi \
				| grep -E '.' \
				|| printf '0000000000000000000000000000000000000000'
			)"
			nt_sha="$(
				#shellcheck disable=SC2059
				printf -- "$file" \
				| xargs -0 -- git --literal-pathspecs ls-files --error-unmatch -- 1>/dev/null 2>&1 \
				&& printf -- "$file" \
				| xargs -0 -- git --literal-pathspecs hash-object -- 2>/dev/null \
				|| printf '0000000000000000000000000000000000000000'
			)"
			nu_sha="$(
				#shellcheck disable=SC2059
				printf -- "$file" \
				| xargs -0 -- git --literal-pathspecs hash-object -- 2>/dev/null \
				|| printf '0000000000000000000000000000000000000000'
			)"
			oi="$(test "$oi_sha" = '0000000000000000000000000000000000000000' && printf '0' || printf '1')"
			ot="$(test "$ot_sha" = '0000000000000000000000000000000000000000' && printf '0' || printf '1')"
			ou="$(test "$ou_sha" = '0000000000000000000000000000000000000000' && printf '0' || printf '1')"
			ni="$(test "$ni_sha" = '0000000000000000000000000000000000000000' && printf '0' || printf '1')"
			nt="$(test "$nt_sha" = '0000000000000000000000000000000000000000' && printf '0' || printf '1')"
			nu="$(test "$nu_sha" = '0000000000000000000000000000000000000000' && printf '0' || printf '1')"
			# The ifs can be interpreted by their direct meaning but it's complicated.
			# Conditions are in a large part generated by a Karnaugh map solver. You can find the input data and the result in the commit message of 50abf565859942c5e19dc2dbea8dd583ddd4bf76.
			# index
			if [ "$ni$oi" = '10' ]
			then
				printf 'i A\t%s\n' "$file"
			elif [ "$ni$oi" = '01' ]
			then
				printf 'i D\t%s\n' "$file"
			elif [ "$ni_sha" != "$oi_sha" ]
			then
				printf 'i M\t%s\n' "$file"
			fi
			# tracked
			if [ "$ni$nt$oi" = '011' ] \
				|| [ "$ni$nt$ot" = '010' ] \
				|| [ "$nt$oi$ot" = '110' ]
			then
				printf 't A\t%s\n' "$file"
			elif [ "$ni$nt$oi" = '100' ] \
				|| [ "$ni$nt$ot" = '101' ] \
				|| [ "$nt$oi$ot" = '001' ]
			then
				printf 't D\t%s\n' "$file"
			elif [ "$ni$nt$oi" = '110' ] \
				|| [ "$ni$nt$ot" = '111' ] \
				|| [ "$nt$oi$ot" = '101' ]
			then
				if [ "$ni_sha" = "$oi_sha" ] || [ "$nt_sha" != "$ni_sha" ]
				then
					old_changes="$(
						#shellcheck disable=SC2059
						printf -- "$file" \
						| xargs -0 -- git --literal-pathspecs diff-files -p -- \
						| sed -E -e 's/^@@.*$/@@/'
					)"
					new_changes="$(
						#shellcheck disable=SC2059
						printf -- "$file" \
						| xargs -0 -- git --literal-pathspecs diff-tree -p "$working_dir_changes_sha~2" "$working_dir_changes_sha~1" -- \
						| sed -E -e 's/^@@.*$/@@/'
					)"
					if [ "$old_changes" != "$new_changes" ]
					then
						printf 't M\t%s\n' "$file"
					fi
				fi
			fi
			# untracked
			#shellcheck disable=SC2059
			if ! printf -- "$file" \
				| xargs -0 -- git check-ignore --quiet --
			then
				if [ "$nt$nu$ot" = '011' ] \
					|| [ "$nt$nu$ou" = '010' ]
				then
					printf 'u C\t%s\n' "$file"
				elif [ "$ni$nu$ot$ou" = '0001' ]
				then
					printf 'u D\t%s\n' "$file"
				elif [ "$nt$nu$oi$ot" = '0111' ] \
					|| [ "$nt$nu$ot$ou" = '0101' ]
				then
					if [ "$nu_sha" != "$ou_sha" ]
					then
						printf 'u M\t%s\n' "$file"
					fi
				fi
			elif [ "$summary_mode" = 'complete' ]
			then
				if [ "$ou" = '1' ]
				then
					printf 'u I\t%s\n' "$file"
				elif [ "$nu" = 1 ]
				then
					if printf -- "%s:$file" "$untracked_changes_sha" \
						| xargs -0 -- git --literal-pathspecs rev-parse --verify --quiet 1>/dev/null 2>&1
					then
						printf 'u T\t%s\n' "$file"
					fi
				fi
			fi
		done
	)"
	index_changes="$(
		printf '%s' "$all_changes" \
		| grep -E '^i ' \
		| cut -c3-
	)"
	tracked_changes="$(
		printf '%s' "$all_changes" \
		| grep -E '^t ' \
		| cut -c3-
	)"
	untracked_changes="$(
		printf '%s' "$all_changes" \
		| grep -E '^u ' \
		| cut -c3-
	)"
	if [ -n "$all_changes" ]
	then
		{
			if [ -n "$index_changes" ]
			then
				printf '    %sindex:%s\\n' "$header_color_escape_code" "${header_color_escape_code:+$reset_escape_code}"
				printf '%s\n' "$index_changes" \
				| sed -E -e 's/^A\t(.+)$/added:\t\t\1/' \
					-e 's/^M\t(.+)$/modified:\t\1/' \
					-e 's/^D\t(.+)$/deleted:\t\1/' \
					-e 's/^.+$/\t'"$updated_color_escape_code"'&'"${updated_color_escape_code:+$reset_escape_code}"'\\n/'
			fi
			if [ -n "$tracked_changes" ]
			then
				printf '    %stracked files:%s\\n' "$header_color_escape_code" "${header_color_escape_code:+$reset_escape_code}"
				printf '%s\n' "$tracked_changes" \
				| sed -E -e 's/^A\t(.+)$/added:\t\t\1/' \
					-e 's/^M\t(.+)$/modified:\t\1/' \
					-e 's/^D\t(.+)$/deleted:\t\1/' \
					-e 's/^.+$/\t'"$changed_color_escape_code"'&'"${changed_color_escape_code:+$reset_escape_code}"'\\n/'
			fi
			if [ -n "$untracked_changes" ]
			then
				printf '    %suntracked files:%s\\n' "$header_color_escape_code" "${header_color_escape_code:+$reset_escape_code}"
				printf '%s\n' "$untracked_changes" \
				| sed -E -e 's/^C\t(.+)$/created:\t\1/' \
					-e 's/^M\t(.+)$/modified:\t\1/' \
					-e 's/^D\t(.+)$/deleted:\t\1/' \
					-e 's/^T\t(.+)$/touched:\t\1/' \
					-e 's/^I\t(.+)$/ignored:\t\1/' \
					-e 's/^.+$/\t'"$untracked_color_escape_code"'&'"${untracked_color_escape_code:+$reset_escape_code}"'\\n/'
			fi
		} \
		| tr '\n' '\0' \
		| xargs -0 -n1 -- printf --
	else
		printf '\t%sno changes were made%s\n' "$header_color_escape_code" "${header_color_escape_code:+$reset_escape_code}"
	fi
}

print_rebase_problem() {
	if ! current_rebase_step="$(cat "$(git rev-parse --git-path 'rebase-merge')/msgnum")" \
		|| ! [ "$current_rebase_step" -eq "$current_rebase_step" ] 2>/dev/null \
		|| [ "$current_rebase_step" -lt 2 ] || [ "$current_rebase_step" -gt 6 ]
	then
		printf 'Cannot determine the current stage of merging the stash into the working directory!\n'
	else
		printf 'Currently merging '
		case "$current_rebase_step" in
			2) printf 'staged changes' ;;
			3|4) printf 'unstaged changes' ;;
			5|6) printf 'untracked changes' ;;
		esac
		printf ' from '
		case "$current_rebase_step" in
			2|4|6) printf 'stash' ;;
			3|5) printf 'working directory' ;;
		esac
		printf ' into '
		case "$current_rebase_step" in
			2|4|6) ;;
			3|5) printf 'already merged ' ;;
		esac
		case "$current_rebase_step" in
			2|3|4) printf 'staged changes' ;;
			5|6) printf 'tracked changes' ;;
		esac
		case "$current_rebase_step" in
			2|3|5) ;;
			4|6) printf ' already merged with ' ;;
		esac
		case "$current_rebase_step" in
			2|3|5) ;;
			4) printf 'unstaged changes' ;;
			6) printf 'untracked changes' ;;
		esac
		case "$current_rebase_step" in
			2|4|6) printf ' from working directory' ;;
			3|5) ;;
		esac
		printf '.\n'
	fi 1>&2
	printf_hint 'use '\''git istash --continue'\'' after fixing the conflicts\nor, to undo everything '\''git istash %s'\'' did, run '\''git istash --abort'\''\n' "$(get_sub_command_name)"
}

end_with_rebase_problem() {
	if [ "$is_quiet" = n ]
	then
		print_rebase_problem
	fi
	return 2
}
end_with_success() {
	if { [ "$curr_branch_type" != 'orphan' ] && [ "$(git rev-parse HEAD~6)" != "$(git rev-parse "$current_branch")" ] ; } \
		|| { [ "$curr_branch_type" = 'orphan' ] && [ "$(git rev-list --no-walk --count HEAD~6^@)" != '0' ] ; }
	then
		fatal 'HEAD is not in the correct position after rebasing\n'
	fi
	untracked_changes_sha="$(git rev-parse HEAD~0)"
	non_staged_changes_sha="$(git rev-parse HEAD~2)"
	staged_changes_sha="$(git rev-parse HEAD~4)"
	case "$curr_branch_type" in
		orphan)
			if [ -n "$(git ls-tree -r --name-only HEAD~6)" ]
			then
				# This error is untested because it's hard to come up with a scenario so contrived that it would occur.
				fatal 'the empty commit created for the command is not empty\n'
			fi
			git branch --quiet --delete --force "$current_branch"
			git switch --quiet --orphan "$current_branch"
			;;
		normal)
			git switch --quiet "$current_branch"
			;;
		detached)
			git switch --quiet --detach HEAD~6
			;;
	esac
	put_files_into_working_copy "$untracked_changes_sha" "$non_staged_changes_sha" "$staged_changes_sha"
	delete_data
	if [ "$is_quiet" != y ]
	then
		printf 'Stash of the old working dir: %s\n' "$(prepare_stash_of_working_dir)"
		print_changes_summary
		if [ "$is_pop" = n ]
		then
			printf '\nSuccessfully applied the stash\n'
		fi
	fi
}

check_data_files() { # resume quit
	if [ "$is_pop" = y ] ; then return 0 ; fi
	operation_in_progress="$(find_data_files)"
	case "$operation_in_progress" in
		pop)
			if [ "$2" = y ] ; then return 0 ; fi
			print_error_for_data_files_check "$operation_in_progress" 'apply'
			error
			;;
		apply)
			if [ "$1" = y ] || [ "$2" = y ] ; then return 0 ; fi
			print_error_for_data_files_check "$operation_in_progress" 'apply'
			error
			;;
		error-*)
			if [ "$2" = y ] ; then return 0 ; fi
			print_error_for_data_files_check "$operation_in_progress" 'apply'
			error
			;;
		nothing)
			if [ "$1" = n ] && [ "$2" = n ] ; then return 0 ; fi
			error 'no istash apply in progress\n'
			;;
	esac
}

prepare_current_branch() {
	if [ "$curr_branch_type" = 'orphan' ]
	then
		git commit --quiet --only --allow-empty --message 'Temporary commit by "git-stash"'
	fi
}

commit_working_directory() {
	# initialization
	default_message="$(git rev-list --no-commit-header --format='%h %s' --max-count=1 HEAD)"
	message="Working directory changes prior to applying stash $(git rev-parse "$(get_stash_commit "$stash")")"
	if [ "$curr_branch_type" != 'detached' ]
	then
		branch_name_for_msg="$(git branch --show-current)"
	else
		branch_name_for_msg='(no branch)'
	fi
	git switch --quiet --detach HEAD
	
	# staged
	git commit --quiet --message="index on $branch_name_for_msg: $default_message" --allow-empty
	
	# unstaged
	git --no-literal-pathspecs add --update :/ 1>&2 2>/dev/null || true
	git commit --quiet --message="On $branch_name_for_msg: $message" --allow-empty
	
	# untracked
	git --no-literal-pathspecs add --all --intent-to-add :/ 2>/dev/null || true
	git --no-literal-pathspecs add --update :/ 1>&2 2>/dev/null || true
	git commit --quiet --message="untracked files on $branch_name_for_msg: $default_message" --allow-empty
	
	# save sha
	working_dir_changes_sha="$(git rev-parse 'HEAD')"
}

prepare_stash_of_working_dir() {
	if [ "$(git rev-parse "$working_dir_changes_sha^{tree}")" = "$(git rev-parse "$working_dir_changes_sha~1^{tree}")" ]
	then
		tangle_stash "$working_dir_changes_sha~1" n
	else
		tangle_stash "$working_dir_changes_sha" y
	fi
}

run_first_time_rebase() { # untangled_stash_sha
	todo_list_editor="sed -i -E \
			-e '1 i pick $working_dir_changes_sha~2 Staged working directory' \
			-e '2 i pick $working_dir_changes_sha~1 Unstaged working directory' \
			-e '3 i pick $working_dir_changes_sha~0 Untracked working directory'"
	set -- --onto "$current_branch" "$1~3" "$1" --empty=keep --keep-empty --reapply-cherry-picks --interactive
	if [ "$is_quiet" = n ]
	then
		GIT_EDITOR="$todo_list_editor" git rebase "$@" 2>/dev/null
	else
		GIT_EDITOR="$todo_list_editor" git rebase "$@" 1>/dev/null 2>&1
	fi
}

start_rebase() { # untangled_stash_sha
	if run_first_time_rebase "$1"
	then
		end_with_success
	elif are_there_conflicts
	then
		end_with_rebase_problem
	else
		do_abort
		fatal
	fi
}

do_start() { # args...
	check_args_for_apply 1 "$@"
	check_data_files n n
	check_other_git_commands_state
	find_stash "$@"
	find_current_branch
	prepare_current_branch
	commit_working_directory
	save_data
	stash_sha="$(get_stash_commit "$stash")"
	untangled_stash_sha="$(untangle_git_stash "$stash_sha")"
	start_rebase "$untangled_stash_sha"
}

run_continued_rebase() {
	if [ "$is_quiet" = n ]
	then
		git -c 'core.editor=true' rebase --continue
	else
		git -c 'core.editor=true' rebase --continue 1>/dev/null
	fi
}

do_continue() { # args...
	check_args_for_apply 0 "$@"
	check_data_files y n
	load_data "$(get_sub_command_name)"
	
	git commit --quiet --allow-empty --no-edit 1>/dev/null 2>&1 || true
	exec 3>&1
	if stderr="$(run_continued_rebase 2>&1 1>&3)"
	then
		exec 3>&-
		end_with_success
	elif are_there_conflicts
	then
		exec 3>&-
		end_with_rebase_problem
	else
		exec 3>&-
		git reset --quiet --soft HEAD~
		printf '%s' "$stderr" | color_fatal 1>&2
		fatal
	fi
}

do_abort() { # args...
	check_args_for_apply 0 "$@"
	check_data_files y n
	load_data "$(get_sub_command_name)"
	
	error_message="$(git rebase --abort 2>&1 || true)"  # Errors are ignored because if rebase is not in progress, we still want to try to restore HEAD.
	if [ -n "$error_message" ]
	then
		printf '%s\n' "$error_message" | color_fatal 1>&2
	fi
	git reset --quiet --hard
	succeeded_switch=n
	exec 3>&1
	case "$curr_branch_type" in
		orphan)
			git branch --quiet --delete --force "$current_branch"
			if error_message="$(git switch --quiet --orphan "$current_branch" 2>&1 1>&3)"
			then
				succeeded_switch=y
			fi
			;;
		normal)
			if error_message="$(git switch --quiet "$current_branch" 2>&1 1>&3)"
			then
				succeeded_switch=y
			fi
			;;
		detached)
			if error_message="$(git switch --quiet --detach --quiet "$current_branch" 2>&1 1>&3)"
			then
				succeeded_switch=y
			fi
			;;
	esac
	exec 3>&-
	
	if [ "$succeeded_switch" = y ]
	then
		put_files_into_working_copy "$(git rev-parse "$working_dir_changes_sha~0")" "$(git rev-parse "$working_dir_changes_sha~1")" "$(git rev-parse "$working_dir_changes_sha~2")"
		is_really_pop="$(if [ -f "$(make_stash_data_file_path)" ] ; then printf 'y' ; else printf 'n' ; fi)"
		
		delete_data
		
		if [ "$is_quiet" = n ]
		then
			if [ "$is_really_pop" = n ]
			then
				printf 'Successfully aborted '\''git istash apply'\''\n'
			else
				printf 'Successfully aborted '\''git istash pop'\''\n'
			fi 1>&2
		fi
	else
		printf_fatal 'failed to restore HEAD to initial position\n'
		printf '%s\n' "$error_message" | color_fatal 1>&2
		print_broken_operation_hint '--abort'
		fatal
	fi
}

do_quit() { # args...
	check_args_for_apply 0 "$@"
	check_data_files n y
	
	if [ "$is_pop" = n ]
	then
		set -- --quit "$@"
		if [ "$is_quiet" = y ]
		then
			set -- --quiet "$@"
		fi
		exec sh "$lib_dir/git-istash-pop" "$@"
	fi
	
	git rebase --quit 2>/dev/null || true  # Errors are ignored because if rebase is not in progress or broken, we still want to remove the data files.
	is_really_pop="$(if [ -f "$(make_stash_data_file_path)" ] ; then printf 'y' ; else printf 'n' ; fi)"
	delete_data
	
	if [ "$is_quiet" = n ]
	then
		if [ "$is_really_pop" = n ]
		then
			printf 'Successfully quit '\''git istash apply'\''\n'
		else
			printf 'Successfully quit '\''git istash pop'\''\n'
		fi 1>&2
	fi
}

do_apply() { # args...
	if [ "$continue_set" = y ]
	then
		do_continue "$@"
	elif [ "$abort_set" = y ]
	then
		do_abort "$@"
	elif [ "$quit_set" = y ]
	then
		do_quit "$@"
	else
		do_start "$@"
	fi
}

getopt_short_options='chq'
getopt_long_options='abort,_called-from-pop,_called-from-pop_,color::,no-color,continue,quiet,quit,summary:'
normalized_options="$(get_options_color "$getopt_short_options" "$getopt_long_options" "$@")"
eval set -- "$normalized_options"
abort_set=n
is_pop=n
continue_set=n
is_quiet=n
quit_set=n
while true
do
	case "$1" in
	--abort)
		abort_set=y
		;;
	--_called-from-pop*)
		is_pop=y
		;;
	--color)
		shift
		set_color_for_all "$1"
		;;
	--no-color)
		set_color_for_all 'never'
		;;
	-c|--continue)
		continue_set=y
		;;
	-h)
		print_help
		exit 0
		;;
	-q|--quiet)
		is_quiet=y
		;;
	--quit)
		quit_set=y
		;;
	--summary)
		shift
		set_summary_mode "$1"
		;;
	--)
		shift
		break
		;;
	esac
	shift
done
if [ $continue_set = y ] && [ $abort_set = y ] && [ $quit_set = y ]
then
	error 'you can choose continue, abort or quit at your discretion but the rule is that you can only have one\n'
fi
if [ $abort_set = y ] && [ $quit_set = y ]
then
	error 'either abort or quit; there is no middle road\n'
fi
if [ $continue_set = y ] && [ $abort_set = y ]
then
	error 'unclear whether to continue aborting or to abort continuing\n'
fi
if [ $continue_set = y ] && [ $quit_set = y ]
then
	error 'unclear whether to continue quitting or to quit continuing\n'
fi

lib_dir="$(cd "$(dirname "$0")" ; pwd)"
cd "$(git rev-parse --show-toplevel)"
target_data_file="$(make_target_data_file_path)"
working_dir_sha_file="$(make_working_dir_sha_file_path)"
do_apply "$@"
